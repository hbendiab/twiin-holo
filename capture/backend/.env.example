# Gladia — https://app.gladia.io
GLADIA_API_KEY=
GLADIA_LANGUAGES=fr,en
GLADIA_SUMMARIZE=true

# H Company — https://portal.hcompany.ai (Agents API)
HAI_API_KEY=
HAI_BASE_URL=https://agp.eu.hcompany.ai/api/v2
HAI_DEFAULT_AGENT=h/web-surfer-flash
HAI_SKILL_NAMESPACE=
# Connexion aux sites dans le navigateur cloud H (voir README « Connecter l'agent à Stripe »)
HAI_VAULT_ID=
HAI_USE_DEFAULT_PROFILE=true
HAI_BROWSER_PROFILE_ID=

# Le navigateur cloud de H ne voit pas localhost : réécrit les URL locales de la capture vers l'URL publique
# (ex : tunnel `cloudflared tunnel --url http://127.0.0.1:8042`). Plusieurs paires séparées par des virgules.
TWIIN_URL_REWRITE=

# Optionnel : protège les endpoints d'écriture (header X-Twiin-Key, à mettre aussi dans l'extension)
TWIIN_API_KEY=
# TWIIN_DATA_DIR=./data/recordings
