# Modèle du fichier .env de la brique Twiin (dossier twiin/). Copier en .env et remplir. AUCUNE vraie valeur ici.

# ── Analyse des enregistrements (Hugging Face) ──
HF_TOKEN=                                   # huggingface.co/settings/tokens
HF_MODEL=Qwen/Qwen3.8-27B                   # généraliste vision (découpage en workflows, conseils, verdict, plans n8n)
# HF_MAX_FRAMES=24                          # images envoyées au modèle par analyse
# HF_REASONING_EFFORT=low                   # raisonnement réduit : la réponse n'est pas coupée
RECORDER_MODE=faithful                      # faithful = copie fidèle de la tâche ; daily = routine quotidienne (ImproveMe d'origine)

# ── Holo (H Company) : rejeu, « Fais-le à ma place », blocs Holo des automatisations ──
HAI_API_KEY=                                # portal.hcompany.ai
HOLO_AGENT=h/web-surfer-flash               # agent H par défaut (Holo 4) ; les agents créés par Twiin utilisent HOLO_MODEL
HOLO_MODEL=holo3-1-35b-a3b                  # modèle des agents créés par Twiin (Holo 3.1)

# ── Voix off des tutos vidéo (ElevenLabs, le forfait gratuit suffit) ──
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                        # ex. voix « Matilda » ; modèle multilingue -> français

# ── n8n local (automatisations) : voir automation/n8n-runtime/start.sh ──
N8N_LOCAL_URL=http://localhost:5678
N8N_LOCAL_API_KEY=                          # n8n → Settings → n8n API
N8N_LOCAL_MCP_TOKEN=                        # n8n → Settings → MCP Access → Access token (commence par eyJ)
TWIIN_LOCAL_TOKEN=                          # jeton du pont n8n -> Holo ; générer : python3 -c "import secrets;print(secrets.token_urlsafe(24))"
N8N_SHEET_VEILLE_ID=                        # identifiant du Google Sheet « veille » (dans son URL)
N8N_SHEET_VEILLE_GID=                       # identifiant de l'onglet (gid)
N8N_SHEET_FACTURES_ID=
N8N_SHEET_FACTURES_GID=

# ── Facultatif (ImproveMe d'origine) ──
WHATSAPP_NOTIFY_TARGET=                     # notification WhatsApp via NemoClaw (non utilisé par Twiin)

# ── Supabase (base de données partagée de l'équipe ; texte et chiffres seulement, les captures restent sur le Mac) ──
# Chaque membre se connecte avec SON compte. Clé PUBLIQUE uniquement (« publishable » / anon). Ne JAMAIS mettre la clé service_role ici.
SUPABASE_URL=https://yazaogxmsknjxbgabnrq.supabase.co
SUPABASE_PUBLISHABLE_KEY=                   # la page Twiin la lit aussi sous l'ancien nom SUPABASE_ANON_KEY
# Script de test de connexion (recorder/test-supabase.mjs) : compte de l'équipe créé par l'admin
SUPABASE_EMAIL=
SUPABASE_PASSWORD=
# Installation des tables seulement (facultatif) : adresse de la base (Connect → « Session pooler », contient le mot de
# passe) ou jeton personnel Supabase (accès à tout le compte, à supprimer ensuite).
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=

# ── Découverte de la tâche + environnement de test (discovery/) ──
DISCOVERY=off                               # on : découverte + environnement de test après l'analyse (Lucas)
# DISCOVERY_DEV_MODEL=holo4-35b-a3b         # modèle des 3 parcours exploratoires (holo3-1-35b-a3b = gratuit, plus lent)
# DISCOVERY_CASSE_MODEL=holo4-35b-a3b       # modèle des itérations après le « oui »
# DISCOVERY_AGENTS=3                        # parcours exploratoires lancés en même temps
# DISCOVERY_N8N=on                          # off : pas d'itérations n8n (sinon : n8n local + n8ncli env LOCAL requis)
# N8N_LOCAL_API_KEY= / N8N_LOCAL_MCP_TOKEN= # facultatif si `n8ncli envs edit LOCAL ...` est déjà fait
# DISCOVERY_UPLOAD_CAPTURES=off            # on : envoie aussi les captures dans Supabase (par défaut elles restent sur le poste)
